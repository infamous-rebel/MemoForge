FROM python:3.11-slim

WORKDIR /app

# Install build tools + WeasyPrint system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libpango-1.0-0 libpangoft2-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-xlib-2.0-0 libcairo2 libffi-dev shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Run only the server – DO NOT seed on startup (data persists)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]FROM 
