{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://memoforge-production.up.railway.app/:path*" },
    { "source": "/v1/:path*", "destination": "https://memoforge-production.up.railway.app/v1/:path*" },
    { "source": "/((?!assets|static|favicon|_next|.*\\..*).*)", "destination": "/index.html" }
  ]
}
