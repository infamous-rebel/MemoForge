# =============================================================================
# MemoForge Environment Configuration
# =============================================================================

# --- Application ---
APP_NAME=MemoForge
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Mock Mode ---
# When true: uses MockProvider for LLM, mock connectors for integrations.
# When false: requires real API keys; raises LLMProviderError if missing.
MOCK_MODE=true

# --- Integration Mode ---
# "mock" = synthetic data connectors (no external APIs needed)
# "real" = live bank connectors (requires credentials below)
INTEGRATION_MODE=mock

# --- Database ---
DATABASE_URL=postgresql://memoforge:memoforge@localhost:5432/memoforge
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- LLM Provider ---
# Supported: anthropic, openai, azure, ollama, mock
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Azure OpenAI (only if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock (only if LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ---
EMBEDDING_PROVIDER=tfidf
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-finance-2

# --- RAG ---
RAG_TOP_K=10
RAG_ACL_ENABLED=true

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@memoforge.local
NOTIFICATION_DEFAULT_CHANNELS=email,in_app
