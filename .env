# =============================================================================
# MemoForge Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to version control.
# =============================================================================

# --- Application ---
APP_NAME=MemoForge
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
MOCK_MODE=true

# --- Database ---
DATABASE_URL=sqlite:///./memoforge.db
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- LLM Provider ---
# Supported: anthropic, openai, azure, bedrock, ollama, mock
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Azure-specific (when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Bedrock-specific (when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ollama-specific (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding Provider ---
# Supported: voyage, openai, cohere, tfidf
EMBEDDING_PROVIDER=tfidf
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-finance-2

# --- RAG ---
RAG_TOP_K=10
RAG_ACL_ENABLED=true

# --- Notifications ---
# Comma-separated channels: email, sms, whatsapp, in_app
NOTIFICATION_DEFAULT_CHANNELS=email,in_app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@memoforge.local
